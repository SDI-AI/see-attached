<Window x:Class="ReportCreator.Builder.PageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page setup" Width="480" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Paper}" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}" />
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,0,22,22">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource InkButton}" Click="Ok_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,22,22,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Paper" />
            <ComboBox x:Name="PaperBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="PaperBox_SelectionChanged" />
            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Orientation" />
            <ComboBox x:Name="OrientationBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Custom width" />
            <TextBox x:Name="WidthBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Custom height" />
            <TextBox x:Name="HeightBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Top margin" />
            <TextBox x:Name="TopBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Right margin" />
            <TextBox x:Name="RightBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Bottom margin" />
            <TextBox x:Name="BottomBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="Left margin" />
            <TextBox x:Name="LeftBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Page header" />
            <TextBox x:Name="HeaderBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Text="Page footer" />
            <TextBox x:Name="FooterBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="Page numbers" />
            <ComboBox x:Name="NumberBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,8" />
            <CheckBox x:Name="FirstNumberBox" Grid.Row="11" Grid.Column="1" Margin="0,0,0,8" Content="Number the first page" />
            <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,8" FontWeight="SemiBold" Text="Watermark" />
            <CheckBox x:Name="WatermarkBox" Grid.Row="13" Grid.Column="1" Margin="0,0,0,8" Content="Print behind every page" />
            <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Text="Kind" />
            <ComboBox x:Name="KindBox" Grid.Row="14" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="15" Grid.Column="0" VerticalAlignment="Center" Text="Text" />
            <TextBox x:Name="MarkTextBox" Grid.Row="15" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="16" Grid.Column="0" VerticalAlignment="Center" Text="Font" />
            <ComboBox x:Name="FontBox" Grid.Row="16" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="17" Grid.Column="0" VerticalAlignment="Center" Text="Size pt" />
            <TextBox x:Name="SizeBox" Grid.Row="17" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="18" Grid.Column="0" VerticalAlignment="Center" Text="Color" />
            <TextBox x:Name="ColorBox" Grid.Row="18" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="19" Grid.Column="0" VerticalAlignment="Center" Text="Opacity" />
            <TextBox x:Name="OpacityBox" Grid.Row="19" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="20" Grid.Column="0" VerticalAlignment="Center" Text="Rotation" />
            <TextBox x:Name="RotationBox" Grid.Row="20" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="21" Grid.Column="0" VerticalAlignment="Center" Text="Horizontal" />
            <ComboBox x:Name="HorizontalBox" Grid.Row="21" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="22" Grid.Column="0" VerticalAlignment="Center" Text="Vertical" />
            <ComboBox x:Name="VerticalBox" Grid.Row="22" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="23" Grid.Column="0" VerticalAlignment="Center" Text="Image source" />
            <TextBox x:Name="SourceBox" Grid.Row="23" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="24" Grid.Column="0" VerticalAlignment="Center" Text="Image width" />
            <TextBox x:Name="ImageWidthBox" Grid.Row="24" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="25" Grid.Column="0" VerticalAlignment="Center" Text="Image height" />
            <TextBox x:Name="ImageHeightBox" Grid.Row="25" Grid.Column="1" Margin="0,0,0,8" />
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
