<Window x:Class="ReportCreator.Builder.PageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page setup" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Paper}" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}" />
    </Window.Resources>
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Paper" />
        <ComboBox x:Name="PaperBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="PaperBox_SelectionChanged" />
        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Orientation" />
        <ComboBox x:Name="OrientationBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Custom width" />
        <TextBox x:Name="WidthBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Custom height" />
        <TextBox x:Name="HeightBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Top margin" />
        <TextBox x:Name="TopBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Right margin" />
        <TextBox x:Name="RightBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Bottom margin" />
        <TextBox x:Name="BottomBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="Left margin" />
        <TextBox x:Name="LeftBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Page header" />
        <TextBox x:Name="HeaderBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Text="Page footer" />
        <TextBox x:Name="FooterBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="Page numbers" />
        <ComboBox x:Name="NumberBox" Grid.Row="10" Grid.Column="1" Margin="0,0,0,8" />
        <CheckBox x:Name="FirstNumberBox" Grid.Row="11" Grid.Column="1" Margin="0,0,0,8" Content="Number the first page" />
        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource InkButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
