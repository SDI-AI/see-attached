<Window x:Class="ReportCreator.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Report Creator" Height="820" Width="1240"
        Loaded="Window_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="New_Click" />
                <MenuItem Header="New _invoice sample" Click="Sample_Click" />
                <MenuItem Header="_Open..." Click="Open_Click" />
                <MenuItem Header="Open _data..." Click="OpenData_Click" />
                <MenuItem Header="_Save" Click="Save_Click" />
                <MenuItem Header="Save _as..." Click="SaveAs_Click" />
                <Separator />
                <MenuItem Header="Export _HTML..." Click="ExportHtml_Click" />
                <MenuItem Header="Export _PDF..." Click="ExportPdf_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Page setup..." Click="Page_Click" />
        </Menu>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="8" Text="Ready" TextTrimming="CharacterEllipsis" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Blocks" />
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                    <ComboBox x:Name="AddBand" SelectedIndex="1" Margin="0,0,0,6">
                        <ComboBoxItem Content="Header" />
                        <ComboBoxItem Content="Body" />
                        <ComboBoxItem Content="Footer" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="AddKind" Width="150" SelectedIndex="0">
                            <ComboBoxItem Content="Text" />
                            <ComboBoxItem Content="Field" />
                            <ComboBoxItem Content="Image" />
                            <ComboBoxItem Content="Spacer" />
                            <ComboBoxItem Content="Columns" />
                            <ComboBoxItem Content="Table" />
                        </ComboBox>
                        <Button Content="Add" Margin="8,0,0,0" Padding="10,4" Click="Add_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Up" Padding="10,4" Click="Up_Click" />
                    <Button Content="Down" Padding="10,4" Margin="6,0,0,0" Click="Down_Click" />
                    <Button Content="Delete" Padding="10,4" Margin="6,0,0,0" Click="Delete_Click" />
                </StackPanel>
                <ListBox x:Name="BlockList" DisplayMemberPath="Label" SelectionChanged="BlockList_SelectionChanged" />
            </DockPanel>
            <wv2:WebView2 x:Name="Preview" Grid.Column="1" />
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Properties" Margin="8" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
