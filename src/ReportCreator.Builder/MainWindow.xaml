<Window x:Class="ReportCreator.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="See Attached" Height="900" Width="1360"
        Background="{StaticResource Canvas}"
        FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Ink}" Padding="22,0" Height="52">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentLabel" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="JSON layout" Foreground="#C8C4BC" Margin="28,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="See Attached" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#26171717" BorderThickness="0,0,0,1" Padding="10,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Menu Background="Transparent" VerticalAlignment="Center" FontSize="14">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" Click="New_Click" />
                        <MenuItem Header="New _invoice sample" Click="Sample_Click" />
                        <MenuItem Header="_Open..." Click="Open_Click" />
                        <MenuItem Header="_Save" Click="Save_Click" />
                        <MenuItem Header="Save _as..." Click="SaveAs_Click" />
                        <Separator />
                        <MenuItem Header="Open _data..." Click="OpenData_Click" />
                        <MenuItem Header="Ne_w data" Click="NewData_Click" />
                        <MenuItem Header="Sa_ve data" Click="SaveData_Click" />
                        <MenuItem Header="Save data as..." Click="SaveDataAs_Click" />
                        <Separator />
                        <MenuItem Header="Export _HTML..." Click="ExportHtml_Click" />
                        <MenuItem Header="Export _PDF..." Click="ExportPdf_Click" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="Exit_Click" />
                    </MenuItem>
                </Menu>
                <Button Content="Page setup" Style="{StaticResource ToolLink}" Click="Page_Click" />
                <Button Content="Open data" Style="{StaticResource ToolLink}" Click="OpenData_Click" />
                <Button Content="Export HTML" Style="{StaticResource ToolLink}" Click="ExportHtml_Click" />
                <Button Content="Export PDF" Style="{StaticResource ToolLink}" Click="ExportPdf_Click" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Background="{StaticResource Paper}" Margin="0">
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <ComboBox x:Name="AddBand" Style="{StaticResource FieldCombo}" SelectedIndex="1">
                        <ComboBoxItem Content="Header" />
                        <ComboBoxItem Content="Body" />
                        <ComboBoxItem Content="Footer" />
                        <ComboBoxItem Content="Page header" />
                        <ComboBoxItem Content="Page footer" />
                    </ComboBox>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AddKind" Style="{StaticResource FieldCombo}" Margin="0,0,8,0" SelectedIndex="0">
                            <ComboBoxItem Content="Text" />
                            <ComboBoxItem Content="Field" />
                            <ComboBoxItem Content="Image" />
                            <ComboBoxItem Content="Spacer" />
                            <ComboBoxItem Content="Columns" />
                            <ComboBoxItem Content="Table" />
                        </ComboBox>
                        <Button Grid.Column="1" Content="Add" Style="{StaticResource InkButton}" VerticalAlignment="Top" Click="Add_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Up" Style="{StaticResource QuietButton}" Click="Up_Click" />
                        <Button Content="Down" Style="{StaticResource QuietButton}" Margin="4,0,0,0" Click="Down_Click" />
                        <Button Content="Delete" Style="{StaticResource QuietButton}" Margin="4,0,0,0" Click="Delete_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Margin="2,4,0,0" Text="Text · Field · Image" />
                    <TextBlock Style="{StaticResource Eyebrow}" Margin="2,2,0,0" Text="Spacer · Columns · Table" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Margin="18,18,16,4" Text="REPORT BLOCKS" />
                <ListBox x:Name="BlockList" Margin="16,0,16,8" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         SelectionChanged="BlockList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ContentPresenter />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" BorderBrush="#26171717" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Ink}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="{StaticResource Card}" BorderBrush="#26171717" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="{Binding CardMargin, Mode=OneWay}">
                                            <DockPanel>
                                                <Border Width="8" Height="8" BorderBrush="{StaticResource Blue}" BorderThickness="1.5" CornerRadius="1" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}">
                                                    <Run Text="{Binding KindLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Slash, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                                    <Run Text="{Binding Summary, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Wash}" />
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Blue}" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Blue}" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="1" Background="{StaticResource Canvas}">
                <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="16,8,16,12" HorizontalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="12" Text="Ready" TextTrimming="CharacterEllipsis" />
                <wv2:WebView2 x:Name="Preview" Margin="28,24,28,0" />
            </DockPanel>
            <Border Grid.Column="2" Background="{StaticResource Paper}" BorderBrush="#26171717" BorderThickness="1,0,0,0">
                <DockPanel Margin="20,18,18,16">
                    <TextBlock x:Name="PropertiesHeading" DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Text="PROPERTIES" />
                    <Expander DockPanel.Dock="Bottom" IsExpanded="True" Margin="0,12,0,0">
                        <Expander.Header>
                            <TextBlock x:Name="DataHeading" Text="DATA  /  unsaved" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <Button Content="Edit data" Style="{StaticResource InkButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="EditData_Click" />
                            <Button Content="Open" Style="{StaticResource QuietButton}" Click="OpenData_Click" />
                            <Button Content="Save" Style="{StaticResource QuietButton}" Click="SaveData_Click" />
                            <Button Content="Insert missing fields" Style="{StaticResource QuietButton}" Click="FillData_Click" />
                        </StackPanel>
                    </Expander>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Properties" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
