    </EmbeddedResource>
    <EmbeddedResource Include="..\..\fixtures\invoice\data.json">
      <LogicalName>invoice.data.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
